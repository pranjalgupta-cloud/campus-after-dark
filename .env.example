# ════════════════════════════════════════════════
# Campus After Dark — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to version control
# ════════════════════════════════════════════════

# Django core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database
# Leave blank to use SQLite (default for local dev)
# For MySQL: mysql://user:password@localhost:3306/campus_after_dark
# For PostgreSQL: postgres://user:password@localhost:5432/campus_after_dark
DATABASE_URL=

# Email (for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Payment Gateway (Razorpay) — leave blank for demo mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# File Storage (AWS S3 — optional, for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
